#!/usr/bin/env python3
"""
Wayfire Bridge - Main entry point
Sync gsettings to Wayfire configuration
"""

import argparse
import fcntl
import os
import sys
import signal
from pathlib import Path

# Add the wayfire_bridge package to path
sys.path.insert(0, str(Path(__file__).parent))

from wayfire_bridge.logging_config import setup_logging, is_verbose


def acquire_instance_lock():
    """Return a held lock file, or None if another bridge is already running.

    The bridge can be started both from wayfire.ini [autostart] and from the
    systemd user unit; two copies would fight over the same wayfire.ini.
    """
    runtime_dir = os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
    lock_file = open(os.path.join(runtime_dir, 'wayfire-bridge.lock'), 'w')
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock_file.close()
        return None
    return lock_file


def main():
    """Main entry point"""
    parser = argparse.ArgumentParser(description="Sync gsettings to Wayfire configuration")
    parser.add_argument('-v', '--verbose', action='store_true',
                        help="enable debug logging (or set WAYFIRE_BRIDGE_VERBOSE=1)")
    args = parser.parse_args()

    log = setup_logging(verbose=args.verbose or is_verbose())

    lock_file = acquire_instance_lock()
    if lock_file is None:
        log.warning("Another wayfire-bridge is already running, exiting")
        sys.exit(0)

    try:
        # Imported after logging is configured so module loggers inherit it
        from wayfire_bridge.bridge import WayfireBridge

        bridge = WayfireBridge()

        # Setup signal handlers for clean shutdown
        def signal_handler(sig, frame):
            print("\nShutting down Wayfire Bridge...")
            sys.exit(0)

        signal.signal(signal.SIGINT, signal_handler)
        signal.signal(signal.SIGTERM, signal_handler)

        # Run the bridge
        bridge.run()

    except Exception as e:
        print(f"Fatal error: {e}", file=sys.stderr)
        import traceback
        traceback.print_exc()
        sys.exit(1)


if __name__ == '__main__':
    main()
